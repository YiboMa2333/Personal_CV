---
import type { Project } from '../data/portfolio';
import { getProjectMedia } from '../data/media';
import MediaItem from './MediaItem.astro';
interface Props { project: Project }
const { project } = Astro.props;
const media = await getProjectMedia(project);
const definitions = project.mediaGroups ?? [{ id: 'all', title: '', layout: 'two' as const }];
const groups = definitions.map(group => ({ ...group, items: media.map((item,index)=>({item,index})).filter(({item})=>(item.group ?? 'all')===group.id) })).filter(group=>group.items.length);
if (groups.reduce((count,group)=>count+group.items.length,0) !== media.length) throw new Error(`Unassigned media group in ${project.id}`);
---
{media.length > 0 ? <section class="project-media" data-project={project.id} aria-labelledby="media-title">
  <div class="section-heading"><h2 id="media-title">Inside the project</h2><p>Images and demonstrations.</p></div>
  <div class="media-gallery media-groups">{groups.map(group=><section class={`media-group media-group--${group.layout}`} data-media-group={group.id} aria-labelledby={group.title ? `group-${group.id}` : undefined}>
    {group.title && <header class="media-group-heading"><h3 id={`group-${group.id}`}>{group.title}</h3>{group.description && <p>{group.description}</p>}</header>}
    <div class="media-grid">{group.items.map(({item,index})=><MediaItem item={item} index={index} />)}</div>
  </section>)}</div>
  <script>import '../scripts/media';</script>
</section> : <p class="media-pending">Project recordings and screenshots will be added here. Explore the explanatory visual and technical approach below.</p>}
