---
import type { Project } from '../data/portfolio';
import { getProjectMedia } from '../data/media';
interface Props { project: Project }
const { project } = Astro.props;
const media = getProjectMedia(project);
---
{media.length > 0 ? <section class="project-media" aria-labelledby="media-title">
  <div class="section-heading"><h2 id="media-title">Inside the project</h2><p>Images and demonstrations.</p></div>
  <div class="media-gallery">{media.map(item=><figure class="media-item">
    {item.kind === 'video' ? <video controls playsinline preload="none" aria-label={item.caption}><source src={item.url} type={item.mime} /><p>Your browser cannot play this video. <a href={item.url}>Download the video</a>.</p></video> : <a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`Open full image: ${item.caption}`}><img src={item.url} alt={item.caption} loading="lazy" decoding="async" /></a>}
    <figcaption>{item.caption}</figcaption>
  </figure>)}</div>
</section> : <p class="media-pending">Project recordings and screenshots will be added here. Explore the explanatory visual and technical approach below.</p>}
