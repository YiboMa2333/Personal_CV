---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/portfolio';
---
<Layout title="Projects" description="Seven engineering projects by Yibo Ma: accessible interaction, motion input, applied AI, native Windows software and embedded control." theme="projects">
  <div class="shell"><header class="page-heading gallery-heading"><p class="eyebrow">Selected engineering work</p><h1>Projects<span class="accent">.</span></h1><p>Accessible interaction, applied AI and native systems. Choose a project to explore its approach and demos.</p></header>
    <div class="project-gallery">{projects.map(project=><ProjectCard project={project} />)}</div>
  </div>
</Layout>
