---
import { sitePath } from '../../utils/paths';
import Layout from '../../layouts/Layout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import { projects, type Project } from '../../data/portfolio';
export function getStaticPaths() { return projects.map(project=>({params:{id:project.id},props:{project}})); }
interface Props { project: Project }
const { project } = Astro.props;
---
<Layout title={project.title} description={project.summary} theme="projects">
  <article class="shell project-detail">
    <a class="back-link" href={sitePath('/projects/')}>All projects</a>
    <header class="page-heading detail-heading"><p class="eyebrow">{project.category}{project.ongoing && <span class="ongoing"> · Ongoing development</span>}</p><h1>{project.title}<span class="accent">.</span></h1><p>{project.purpose}</p>
      <div class="project-resource-links">{project.source && <a class="text-link" href={project.source} target="_blank" rel="noopener noreferrer">{project.sourceLabel ?? 'View source code on GitHub'}</a>}{project.links?.map(link=><a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}</div>
    </header>
    {project.publication && <section class="project-publication" aria-labelledby="publication-title"><p class="eyebrow">Research paper</p><h2 id="publication-title">{project.publication.title}</h2><p class="publication-credit">{project.publication.author} · {project.publication.venue}</p><p>{project.publication.summary}</p><a class="text-link" href={project.publication.url} target="_blank" rel="noopener noreferrer">Read paper · DOI: {project.publication.doi}</a></section>}
    <ProjectMedia project={project} />
    {project.workflow && <section class="project-workflow" aria-labelledby="workflow-title"><h2 id="workflow-title">How it works</h2><ol>{project.workflow.map(step=><li><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol></section>}
    <section class="detail-approach" aria-labelledby="approach-title"><h2 id="approach-title">The idea</h2><ProjectVisual id={project.id} />
      <div class="project-explanation"><div><h3>My contribution</h3><p>{project.contribution}</p></div><div><h3>{project.ongoing ? 'Current status' : 'Result'}</h3><p>{project.outcome}</p></div></div>
      <h3 class="technology-heading">Technology and methods</h3><p class="tech-list">{project.technologies.join(' / ')}</p><details><summary>Technical approach</summary><p>{project.detail}</p></details>
    </section>
    <nav class="other-projects" aria-label="Other projects"><h2>Keep exploring</h2><div>{projects.filter(other=>other.id!==project.id).map(other=><a href={sitePath(`/projects/${other.id}/`)}>{other.short}</a>)}</div></nav>
  </article>
</Layout>
