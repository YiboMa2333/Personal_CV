---
import Layout from '../layouts/Layout.astro';
import { education, activities, skills, moduleGroups, apResults, awards, experience } from '../data/portfolio';
---
<Layout title="Background" description="Yibo Ma’s education, honours, activities and technical experience." theme="background">
  <div class="shell"><header class="page-heading"><p class="eyebrow">The person behind the projects</p><h1>Always<br />building on it<span class="accent">.</span></h1><p>Computer Science at UCL, with experience across software, systems and collaborative engineering.</p></header>
    <nav class="local-nav" aria-label="Background sections">{[['education','Education'],['awards','Honours and Awards'],['activities','Extracurricular Activities'],['skills','Technical Skills'],['experience','Additional Experience']].map(([id,label])=><a href={`#${id}`}>{label}</a>)}</nav>
    <section id="education" class="background-section">
      <h2>Education</h2>
      <div class="timeline">{education.map((item,index)=><article>
        <p class="eyebrow">{item.period}</p><h3>{item.institution}</h3><p class="qualification">{item.qualification}</p><p>{item.details}</p>
        {index === 0 ? <details class="education-detail"><summary>Explore UCL modules</summary><div class="module-grid">{moduleGroups.map(group=><div><h4>{group.title}</h4><ul>{group.modules.map(module=><li>{module}</li>)}</ul></div>)}</div></details> : <div class="ap-results"><h4>Advanced Placement results</h4><p>Scores on the five-point AP scale.</p>{apResults.map(result=><div><span class="eyebrow">{result.score}</span><p>{result.subjects.join(' · ')}</p></div>)}</div>}
      </article>)}</div>
    </section>
    <section id="awards" class="background-section awards-section"><h2>Honours and Awards</h2><div class="editorial-list">{awards.map(item=><article><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
    <section id="activities" class="background-section activities-section"><h2>Extracurricular Activities</h2><div class="editorial-list">{activities.map(item=><article><div><h3>{item.title}</h3><p class="entry-context">{item.context}</p></div><p>{item.text}</p></article>)}</div></section>
    <section id="skills" class="background-section"><h2>Technical Skills</h2><p>Languages, technologies and foundations from my academic and project work.</p><div class="skill-grid">{skills.map(item=><div><h3>{item.group}</h3><p>{item.items.join(' · ')}</p></div>)}</div></section>
    <section id="experience" class="background-section"><h2>Additional Experience</h2><div class="editorial-list">{experience.map(item=><article><div><h3>{item.role}</h3><p class="entry-context">{item.organisation}</p><p class="eyebrow">{item.period}</p></div><p>{item.text}</p></article>)}</div></section>
  </div>
</Layout>
